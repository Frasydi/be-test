// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @default(cuid())
  email     String   @unique @db.VarChar(254)
  password  String   @db.VarChar(255)
  fullName  String?  @db.VarChar(100)
  role      Roles    @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relation to uploaded files
  uploadedFiles FileUpload[]
  
  @@index([email])
  @@index([createdAt])
}

// File upload tracking
model FileUpload {
  id          Int           @id @default(autoincrement())
  fileName    String
  originalName String
  fileUrl     String?       // URL where file is stored (optional)
  filePath    String?       // Local file path (optional)
  fileSize    Int?
  mimeType    String?
  status      ProcessingStatus @default(PENDING)
  uploadedBy  Int
  processedAt DateTime?
  errorMessage String?      @db.Text
  recordsProcessed Int?     @default(0)
  totalRecords Int?         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  // Relations
  user        User          @relation(fields: [uploadedBy], references: [id])
  products    Product[]     // If processing product data
  salesRecords SalesRecord[] // If processing sales data
  
  @@index([uploadedBy])
  @@index([status])
  @@index([createdAt])
}

// Sample entities that can be created from Excel processing
model Product {
  id          Int         @id @default(autoincrement())
  name        String
  sku         String?     @unique
  description String?     @db.Text
  price       Decimal?    @db.Decimal(10,2)
  category    String?
  stock       Int?        @default(0)
  fileUploadId Int?       // Track which file this came from
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  // Relations
  fileUpload  FileUpload? @relation(fields: [fileUploadId], references: [id])
  salesRecords SalesRecord[]
  
  @@index([sku])
  @@index([category])
  @@index([fileUploadId])
}

model SalesRecord {
  id          Int         @id @default(autoincrement())
  productId   Int?
  productName String?     // In case product doesn't exist in system
  quantity    Int
  unitPrice   Decimal     @db.Decimal(10,2)
  totalAmount Decimal     @db.Decimal(10,2)
  saleDate    DateTime
  customerName String?
  customerEmail String?
  region      String?
  fileUploadId Int?       // Track which file this came from
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  // Relations
  product     Product?    @relation(fields: [productId], references: [id])
  fileUpload  FileUpload? @relation(fields: [fileUploadId], references: [id])
  
  @@index([saleDate])
  @@index([region])
  @@index([fileUploadId])
  @@index([productId])
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum Roles {
  USER
  ADMIN
}
